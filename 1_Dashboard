def load_market_data(tickers, period, interval):
    """Load market data with fallback"""
    try:
        import yfinance as yf
        
        # Загружаем данные
        data = yf.download(
            tickers,
            period=period,
            interval=interval,
            group_by='ticker',
            progress=False
        )
        
        return data
        
    except Exception as e:
        st.error(f"Error loading data: {e}")
        return None

def create_demo_data(tickers, days=252):
    """Create demo data for testing"""
    dates = pd.date_range(end=datetime.now(), periods=days, freq='B')
    demo_data = {}
    
    for ticker in tickers:
        np.random.seed(hash(ticker) % 1000)
        
        # Generate price series with some randomness
        returns = np.random.normal(0.0005, 0.02, days)
        prices = 100 * np.cumprod(1 + returns)
        
        # Add some trend based on ticker
        if 'AAPL' in ticker:
            prices = prices * (1 + np.linspace(0, 0.3, days))
        elif 'MSFT' in ticker:
            prices = prices * (1 + np.linspace(0, 0.2, days))
        elif 'GOOGL' in ticker:
            prices = prices * (1 + np.linspace(0, 0.15, days))
        
        # Create OHLC data
        df = pd.DataFrame({
            'Open': prices * 0.99,
            'High': prices * 1.01,
            'Low': prices * 0.98,
            'Close': prices,
            'Volume': np.random.randint(1000000, 10000000, days)
        }, index=dates)
        
        demo_data[ticker] = df
    
    # Create multi-index dataframe similar to yfinance
    if len(tickers) > 1:
        combined = pd.concat(demo_data, axis=1)
        combined.columns = pd.MultiIndex.from_tuples(
            [(ticker, col) for ticker in demo_data.keys() for col in ['Open', 'High', 'Low', 'Close', 'Volume']],
            names=['Ticker', 'Price']
        )
        return combined
    else:
        return list(demo_data.values())[0]

def calculate_indicators(data, show_sma=False, sma_period=20, show_rsi=False, rsi_period=14):
    """Calculate technical indicators"""
    indicators = {}
    
    if isinstance(data, pd.DataFrame) and 'Close' in data.columns:
        if show_sma:
            indicators['SMA'] = data['Close'].rolling(window=sma_period).mean()
        
        if show_rsi:
            # Calculate RSI
            delta = data['Close'].diff()
            gain = (delta.where(delta > 0, 0)).rolling(window=rsi_period).mean()
            loss = (-delta.where(delta < 0, 0)).rolling(window=rsi_period).mean()
            rs = gain / loss
            indicators['RSI'] = 100 - (100 / (1 + rs))
    
    return indicators

