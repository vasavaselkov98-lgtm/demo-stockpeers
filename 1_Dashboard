def create_single_chart(data, ticker, chart_type, show_volume, height, show_grid, show_sma=False, show_rsi=False):
    """Create a detailed single chart"""
    
    # Определяем количество строк для субплотов
    rows = 1
    row_heights = [1.0]
    
    if show_volume:
        rows += 1
        row_heights = [0.7, 0.3]
    
    if show_rsi:
        rows += 1
        row_heights = [0.6, 0.2, 0.2] if show_volume else [0.7, 0.3]
    
    # Создаем субплотовый график
    fig = make_subplots(
        rows=rows, 
        cols=1,
        shared_xaxes=True,
        vertical_spacing=0.05,
        row_heights=row_heights,
        subplot_titles=[f"{ticker} - Price Chart"] + 
                       ["Volume"] * (1 if show_volume else 0) + 
                       ["RSI"] * (1 if show_rsi else 0)
    )
    
    # Основной ценовой график
    row_idx = 1
    
    if chart_type == "Candlestick":
        fig.add_trace(
            go.Candlestick(
                x=data.index,
                open=data['Open'] if 'Open' in data.columns else data.iloc[:, 0],
                high=data['High'] if 'High' in data.columns else data.iloc[:, 1],
                low=data['Low'] if 'Low' in data.columns else data.iloc[:, 2],
                close=data['Close'] if 'Close' in data.columns else data.iloc[:, 3],
                name="Price",
                showlegend=False
            ),
            row=row_idx, col=1
        )
    else:
        # Line chart
        close_data = data['Close'] if 'Close' in data.columns else data.iloc[:, 3]
        fig.add_trace(
            go.Scatter(
                x=close_data.index,
                y=close_data,
                name="Price",
                line=dict(color='#1f77b4', width=2),
                showlegend=False,
                mode='lines'
            ),
            row=row_idx, col=1
        )
    
    # Добавляем SMA если нужно
    if show_sma and 'Close' in data.columns:
        sma_data = data['Close'].rolling(window=20).mean()
        fig.add_trace(
            go.Scatter(
                x=sma_data.index,
                y=sma_data,
                name="SMA 20",
                line=dict(color='orange', width=1, dash='dash'),
                opacity=0.7,
                showlegend=True
            ),
            row=row_idx, col=1
        )
    
    # Добавляем объем
    if show_volume and 'Volume' in data.columns:
        volume_row = row_idx + 1
        colors = ['red' if data['Close'].iloc[i] < data['Open'].iloc[i] 
                 else 'green' for i in range(len(data))]
        
        fig.add_trace(
            go.Bar(
                x=data.index,
                y=data['Volume'],
                name="Volume",
                marker_color=colors,
                showlegend=False
            ),
            row=volume_row, col=1
        )
    
    # Добавляем RSI если нужно
    if show_rsi and 'Close' in data.columns:
        rsi_row = rows  # Последний ряд
        
        # Calculate RSI
        delta = data['Close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
        rs = gain / loss
        rsi = 100 - (100 / (1 + rs))
        
        fig.add_trace(
            go.Scatter(
                x=rsi.index,
                y=rsi,
                name="RSI",
                line=dict(color='purple', width=1),
                showlegend=False
            ),
            row=rsi_row, col=1
        )
        
        # Add RSI levels
        fig.add_hline(y=70, line_dash="dash", line_color="red", opacity=0.5, row=rsi_row, col=1)
        fig.add_hline(y=30, line_dash="dash", line_color="green", opacity=0.5, row=rsi_row, col=1)
    
    # Настройки layout
    fig.update_layout(
        title=f"{ticker} - Detailed Analysis",
        height=height,
        showlegend=True,
        hovermode='x unified',
        template="plotly_white",
        xaxis_rangeslider_visible=False
    )
    
    # Настройки сетки
    if show_grid:
        for i in range(1, rows + 1):
            fig.update_xaxes(showgrid=True, gridwidth=1, gridcolor='LightGray', row=i, col=1)
            fig.update_yaxes(showgrid=True, gridwidth=1, gridcolor='LightGray', row=i, col=1)
    
    # Display the chart
    st.plotly_chart(fig, use_container_width=True)
    
    # Quick metrics below chart
    if 'Close' in data.columns:
        current_price = data['Close'].iloc[-1]
        prev_price = data['Close'].iloc[-2] if len(data) > 1 else current_price
        change_pct = ((current_price - prev_price) / prev_price * 100) if prev_price != 0 else 0
        
        col1, col2, col3, col4 = st.columns(4)
        with col1:
            st.metric("Current Price", f"${current_price:.2f}", f"{change_pct:.2f}%")
        with col2:
            st.metric("High", f"${data['High'].max():.2f}")
        with col3:
            st.metric("Low", f"${data['Low'].min():.2f}")
        with col4:
            st.metric("Avg Volume", f"{data['Volume'].mean():,.0f}")

def create_mini_chart(data, ticker, chart_type):
    """Create a mini chart for grid/side-by-side display"""
    
    fig = go.Figure()
    
    if chart_type == "Candlestick" and all(col in data.columns for col in ['Open', 'High', 'Low', 'Close']):
        fig.add_trace(go.Candlestick(
            x=data.index,
            open=data['Open'],
            high=data['High'],
            low=data['Low'],
            close=data['Close'],
            name=ticker,
            showlegend=False
        ))
    else:
        # Line chart
        close_data = data['Close'] if 'Close' in data.columns else data.iloc[:, 3]
        fig.add_trace(go.Scatter(
            x=close_data.index,
            y=close_data,
            mode='lines',
            name=ticker,
            line=dict(color='blue', width=1),
            showlegend=False
        ))
    
    # Calculate metrics for mini info
    if 'Close' in data.columns:
        current_price = data['Close'].iloc[-1]
        prev_price = data['Close'].iloc[-2] if len(data) > 1 else current_price
        change_pct = ((current_price - prev_price) / prev_price * 100) if prev_price != 0 else 0
        
        # Mini title with metrics
        fig.update_layout(
            title=f"{ticker}<br>${current_price:.2f} <span style='color: {'green' if change_pct >= 0 else 'red'}'>({change_pct:+.1f}%)</span>",
            height=250,
            margin=dict(t=50, b=20, l=20, r=20),
            xaxis_rangeslider_visible=False,
            showlegend=False,
            template="plotly_white"
        )
    
    # Remove axis labels for cleaner look
    fig.update_xaxes(showticklabels=False, title="")
    fig.update_yaxes(showticklabels=False, title="")
    
    st.plotly_chart(fig, use_container_width=True)

